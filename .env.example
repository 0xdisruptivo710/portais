# Variáveis que o código lê de verdade (process.env). Nenhuma leva prefixo
# VITE_: esse prefixo publica o valor no bundle do navegador, e aqui é tudo
# credencial de servidor. O painel fala com a API pela mesma origem, então o
# front não precisa de nenhuma variável.
#
# Local: este arquivo vira .env (gitignored). Na Vercel: Project Settings >
# Environment Variables.

# Caixa da cliente, lida por IMAP (D1 da spec: App Password, não OAuth).
# A senha é a App Password de 16 caracteres, não a senha da conta Google.
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=

# Supabase. A service_role só pode ser usada dentro de api/ e scripts/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WTS: contato, card e envio. Só é usada com modo_envio = "real".
WTS_TOKEN=

# Fallback de visão/IA dos parsers (teto de gasto e kill-switch em
# portais_config). Sem ela, o e-mail que o parser não entende cai direto na
# fila de revisão em vez de tentar a IA.
OPENAI_API_KEY=

# Entrada do painel: senha única da operação e segredo que assina o cookie
# de sessão. Sem as duas, /api/login e as rotas do painel recusam tudo
# (fail-closed) — é o comportamento desejado, não um bug de configuração.
# Gerar o segredo com algo como: openssl rand -hex 32
ADMIN_SENHA=
ADMIN_SESSION_SECRET=

# Segredo do cron. A Vercel manda "Authorization: Bearer $CRON_SECRET" em
# /api/cron/varrer quando esta variável existe no projeto. Sem ela, a rota
# recusa a varredura.
CRON_SECRET=

# Opcional: conta monitorada que o script de varredura usa (default 1).
PORTAIS_CONTA_ID=
